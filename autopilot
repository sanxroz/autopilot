#!/bin/sh
set -eu

resolve_script_dir() {
  script_path=$1
  while [ -L "$script_path" ]; do
    link=$(readlink "$script_path")
    case "$link" in
      /*) script_path=$link ;;
      *) script_path=$(dirname -- "$script_path")/$link ;;
    esac
  done
  CDPATH= cd -- "$(dirname -- "$script_path")" && pwd -P
}

case "${1:-}" in
  recover)
    shift
    exec bun run "$(resolve_script_dir "$0")/scripts/autopilot-recover.mjs" "$@"
    ;;
  group)
    shift
    exec bun run "$(resolve_script_dir "$0")/scripts/autopilot-group.mjs" "$@"
    ;;
  --help|-h|help|"")
    cat <<'EOF'
Usage:
  autopilot recover [--list]
  autopilot group set <name> [--worktree <path>]
  autopilot group get [--worktree <path>]
  autopilot group clear [--worktree <path>]
EOF
    ;;
  *)
    printf 'Unknown autopilot command: %s\n' "$1" >&2
    exit 1
    ;;
esac
